# FICTITIOUS VALUES ONLY — replace locally, never commit your real .env.
# Browser client currently targets the official project in its generated file.
VITE_SUPABASE_URL=https://example-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=PUBLIC_KEY_PLACEHOLDER

# Required by existing TanStack Start server functions.
SUPABASE_URL=https://example-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=PUBLIC_KEY_PLACEHOLDER
# SERVER ONLY: narrow public appointment request operation.
SUPABASE_SERVICE_ROLE_KEY=SERVER_SECRET_PLACEHOLDER

# Optional anonymous integration test configuration, never privileged keys.
CABINET_TEST_SUPABASE_URL=https://example-project.supabase.co
CABINET_TEST_PUBLISHABLE_KEY=PUBLIC_KEY_PLACEHOLDER